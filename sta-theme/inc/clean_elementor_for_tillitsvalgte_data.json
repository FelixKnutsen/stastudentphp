              {
                "id": "ftv_card1_body_ome9uhu",
                "elType": "widget",
                "widgetType": "html",
                "settings": {
                  "html": "\n                                        <div>\n                                            <h3 style=\"font-size:1.45rem; font-weight:800; color:#fff; margin:0 0 1rem 0;\">Din rolle som studenttillitsvalgt</h3>\n                                            <p style=\"font-size:0.95rem; color:var(--sta-teal-100); line-height:1.7; margin:0 0 1.25rem 0;\">\n                                                En tillitsvalgt er en valgt person som har oppnådd tilliten fra sine medstudenter på Universitetet i Agder (UiA) til å representere dem i prosesser, møter og samlinger hvor studentenes stemme skal løftes. Som tillitsvalgt spiller du en avgjørende rolle for kvalitetssystemet ved UiA.\n                                            </p>\n                                            <div style=\"padding:1rem 1.25rem; border-radius:10px; background:rgba(9,50,47,0.8); border:1px solid rgba(239,115,48,0.4); font-size:0.875rem; color:#fff; line-height:1.6;\">\n                                                <strong style=\"color:var(--sta-orange);\">Viktig:</strong> \n                                                Når du er valgt, må du registrere deg på \n                                                <a href=\"https://innsia.uia.no\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:var(--sta-orange); font-weight:700; text-decoration:underline;\">innsia.uia.no</a> \n                                                for å motta viktig informasjon, invitasjoner til tillitsvalgtsamlinger og opplæring.\n                                            </div>\n                                        </div>"
                },
                "elements": []
              }
            ],
            "isInner": true
          },
